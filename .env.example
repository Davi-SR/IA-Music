# Copy this file to .env. The FastAPI backend loads it on startup.
# Restart the backend after changing any value.

# Storage and public URL
MUSICAI_DATABASE_PATH=data/musicai.db
MUSICAI_PUBLIC_BASE_URL=http://127.0.0.1:8000
MUSICAI_SECURE_COOKIES=false
MUSICAI_COOKIE_SAMESITE=lax
AUDIO_JOB_ROOT=data/jobs
AUDIO_DEMUCS_EXECUTABLE=demucs
AUDIO_MAX_UPLOAD_BYTES=524288000
AUDIO_MAX_CONCURRENT_JOBS=1
AUDIO_PROCESS_TIMEOUT_SECONDS=7200
AUDIO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUDIO_FFMPEG_LOCATION=
TORCH_HOME=
XDG_CACHE_HOME=

# Google OAuth (credentials type: Web application)
# GOOGLE_CLIENT_ID normally ends with .apps.googleusercontent.com
# Add your Google account as a test user while the app is in Testing.
# Authorized redirect URI in Google Cloud:
# http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Password reset e-mail (Gmail example)
MUSICAI_SMTP_HOST=smtp.gmail.com
MUSICAI_SMTP_PORT=587
MUSICAI_SMTP_STARTTLS=true
MUSICAI_SMTP_USERNAME=
MUSICAI_SMTP_PASSWORD=
MUSICAI_SMTP_SENDER=

# Optional expiration controls
MUSICAI_SESSION_TTL_SECONDS=2592000
MUSICAI_PASSWORD_RESET_TTL_SECONDS=3600
